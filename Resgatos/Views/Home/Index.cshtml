<section class="cats">
    <div class="cats-content">

        <h2 class="cats-title">Conheça nossos gatinhos</h2>

        <div class="cats-carousel">

            <button class="cats-arrow cats-arrow-left" aria-label="Gato anterior">
                <i class="fa-solid fa-chevron-left"></i>
            </button>

            <div class="cats-cards">

                <article class="cat-card">
                    <div class="cat-card-image"></div>

                    <div class="cat-card-content">
                        <h3>Nome do gato</h3>
                    </div>
                </article>

