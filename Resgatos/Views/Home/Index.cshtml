@{
    ViewData["Title"] = "Início";
}

<link rel="stylesheet" href="~/css/home.css" asp-append-version="true">

<section class="hero">
    <div class="hero-content">
        <h1>Adote e leve para casa um <strong>amor</strong> para a vida inteira</h1>
        <p>Um projeto social de resgate e reabilitação de gatinhos nas ruas de Curitiba. Lorem ipsum dolor sit amet consectetur elit.</p>
        <div class="hero-content-buttons">
            <button class="btn-pill btn-pill-blue">Preencher formulário</button>
            <button class="btn-pill btn-pill-outline">Conhecer animais</button>
        </div>
    </div>

    <div class="hero-image">
        <!-- placeholder até as fundadoras enviarem as fotos reais -->
    </div>
</section>

