@{
    ViewData["Title"] = "Início";
}

<link rel="stylesheet" href="~/css/home.css" asp-append-version="true">

<section class="hero">
    <div class="hero-content">
        <h1>Adote e leve para casa um <strong>amor</strong> para a vida inteira</h1>
        <p>Um projeto social de resgate e reabilitação de gatinhos nas ruas de Curitiba, com muito carinho, cuidado, proteção e amor.</p>
        <div class="hero-content-buttons">
            <button class="btn-pill btn-pill-blue">Preencher formulário</button>
            <button class="btn-pill btn-pill-outline">Conhecer animais</button>
        </div>
    </div>

    <div class="hero-image">
        <!-- placeholder até as fundadoras enviarem as fotos reais -->
    </div>
</section>

<section class="sobre">
    <div class="sobre-content">
        <h2>Sobre Nós</h2>
        <p class="text-body">Somos um projeto dedicado ao resgate e cuidado de gatos em situação de abandono, promovendo proteção, saúde e adoção responsável. Conheça nossa história e descubra como tudo começou!</p>
        <button class="btn-pill btn-pill-pink">Conheça nossa história</button>
    </div>

    <div class="sobre-image">
        <!-- placeholder até as fundadoras enviarem as fotos reais -->
    </div>
</section>

<section class="doacoes">
    <ul class="doacoes-list">
        <li class="doacoes-item">
            <i class="fa-solid fa-heart"></i>
            <span>Doe o quanto puder e faça a diferença</span>
        </li>
        <li class="doacoes-item">
            <i class="fa-solid fa-heart"></i>
            <span>Contribua com ração, medicamentos e outros itens</span>
        </li>
        <li class="doacoes-item">
            <i class="fa-solid fa-heart"></i>
            <span>Apadrinhe um gatinho e transforme uma vida</span>
        </li>
    </ul>

    <div class="doacoes-content">
        <h2>Apoie o Resgatos</h2>
        <p class="text-body">Sua ajuda faz a diferença na vida de muitos gatinhos! Com sua contribuição, você fortalece nosso importante trabalho diário de resgate, cuidado e proteção dos animais.</p>
        <button class="btn-pill btn-pill-pink">Saiba como doar</button>
    </div>
</section>

<section class="cats">
    <div class="cats-content">

        <h2 class="cats-title">Conheça nossos gatinhos</h2>

        <div class="cats-carousel">

            <button class="cats-arrow cats-arrow-left" aria-label="Gato anterior">
                <i class="fa-solid fa-chevron-left"></i>
            </button>

            <div class="cats-cards">

                <article class="cat-card">
                    <div class="cat-card-image"></div>

                    <div class="cat-card-content">
                        <h3>Nome do gato</h3>
                    </div>
                </article>

                <article class="cat-card">
                    <div class="cat-card-image"></div>

                    <div class="cat-card-content">
                        <h3>Nome do gato</h3>
                    </div>
                </article>

                <article class="cat-card">
                    <div class="cat-card-image"></div>

                    <div class="cat-card-content">
                        <h3>Nome do gato</h3>
                    </div>
                </article>

            </div>

            <button class="cats-arrow cats-arrow-right" aria-label="Próximo gato">
                <i class="fa-solid fa-chevron-right"></i>
            </button>
        </div>

        <button class="btn-pill btn-pill-pink cats-button">
            Ver todos os gatinhos
        </button>

    </div>
</section>

