                    <div class="cat-card-content">
                        <h3>Nome do gato</h3>
                    </div>
                </article>

            </div>

            <button class="cats-arrow cats-arrow-right" aria-label="Próximo gato">
                <i class="fa-solid fa-chevron-right"></i>
            </button>
        </div>

        <button class="btn-pill btn-pill-pink cats-button">
            Ver todos os gatinhos
        </button>

    </div>
</section>

