@{
    ViewData["Title"] = "Doações";
}

<link rel="stylesheet" href="~/css/doacoes.css" asp-append-version="true">

<h1 class="page-title">Saiba como você pode nos ajudar</h1>

<section class="cash-donations">
    <h2 class="section-title">Doações em Dinheiro</h2>
    <div class="cash-donations-content">

        <!-- PIX -->
        <article class="cash-donation-method cash-donation-pix">
            <div class="cash-donation-qr">
                <img src="~/img/doacoes/qr-pix.png" alt="QR Code para doação via PIX">
            </div>

            <div class="cash-donation-info">
                <div class="cash-donation-brand">
                    <img src="~/img/doacoes/logo-pix.png" alt="Pix">
                    <h3>Ana David Pires</h3>
                    <p>Doe qualquer valor, quando puder.</p>
                </div>

                <div class="pix-key">
                    <span class="pix-label">Chave PIX:</span>

                    <div class="pix-value">
                        <strong>00.000.000/0001-00</strong>

                        <button type="button" class="copy-pix" aria-label="Copiar chave PIX">
                            <i class="fa-regular fa-copy"></i>
                        </button>
                    </div>
                </div>
            </div>
        </article>

        <!-- ASSINATURA -->
        <article class="cash-donation-method cash-donation-signature">
            <div class="cash-donation-qr">
                <img src="~/img/doacoes/qr-mercadopago.png" alt="QR Code para acessar a assinatura no Mercado Pago">
            </div>

            <div class="cash-donation-info">
                <div class="cash-donation-brand">
                    <img src="~/img/doacoes/logo-mercadopago.png" alt="Mercado Pago">

                    <h3>Assinatura Mensal</h3>

                    <p>Apoie o ResGatos todo mês e ajude a manter o cuidado com os gatos resgatados.</p>
                </div>

                <a href="https://www.mercadopago.com.br/subscriptions/checkout?preapproval_plan_id=723b356d94c942f19589485fc1c10aac" target="_blank" class="cash-donation-button">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                    <span>Acessar página</span>
                </a>
            </div>
        </article>

    </div>
</section>

<section class="item-donations">
    <h2 class="section-title">Doações de Itens</h2>
    <p class="section-subtitle">Ração, remédios e outros itens ajudam demais no dia a dia dos gatos resgatados.</p>

    <div class="item-donations-content">

        <!-- ENTREGA NA CASA -->
        <article class="item-donation-card item-donation-pickup">
            <div class="item-donation-icon">
                <i class="fa-solid fa-house"></i>
            </div>

            <div class="item-donation-info">
                <h3>Entrega na nossa casa</h3>
                <div class="item-donation-info-location">
                    <i class="fa-solid fa-location-dot"></i>
                    <h5>Estamos localizados no bairro São Lourenço, em Curitiba.</h5>
                </div>
                <p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Quibusdam harum fugit cumque impedit nobis voluptate voluptatibus velit.</p>
            </div>

            <div class="item-donation-actions">
                <a href="https://www.google.com/maps/search/?api=1&query=Bairro+S%C3%A3o+Louren%C3%A7o%2C+Curitiba"
                    target="_blank" rel="noopener" class="item-donation-button">
                    <i class="fa-solid fa-map-location-dot"></i>
                    <span>Ver no mapa</span>
                </a>

                <a href="https://wa.me/554184723090?text=Ol%C3%A1%21%20Gostaria%20de%20doar%20itens%20para%20o%20ResGatos%20por%20Uber%20Flash.%20Pode%20me%20ajudar%20a%20combinar%20o%20envio%3F"
                    target="_blank" rel="noopener" class="item-donation-button item-donation-button-outline-blue">
                    <i class="fa-brands fa-whatsapp"></i>
                    <span>Agendar entrega</span>
                </a>

            </div>
        </article>

        <!-- UBER FLASH -->
        <article class="item-donation-card item-donation-uber">
            <span class="flash-tag">Uber Flash</span>

            <img src="~/img/doacoes/logo-uber.png" alt="Uber">
            <div class="item-donation-uber-brand">
                <h3>Envie sem sair de casa</h3>
                <p>Não consegue vir até nós? Combine o envio da sua doação por Uber Flash direto para a nossa casa, sem custo de deslocamento pra você.</p>
            </div>

            <div class="item-donation-actions">
                <a href="https://www.uber.com/br/pt-br/" target="_blank" rel="noopener"
                    class="item-donation-button item-donation-button-light">
                    <i class="fa-solid fa-download"></i>
                    <span>Baixe o app</span>
                </a>

                <a href="https://wa.me/554184723090?text=Ol%C3%A1%21%20Gostaria%20de%20doar%20itens%20para%20o%20Resgatos%20por%20Uber%20Flash.%20Pode%20me%20ajudar%20a%20combinar%20o%20envio%3F"
                    target="_blank" rel="noopener" class="item-donation-button item-donation-button-outline">
                    <i class="fa-brands fa-whatsapp"></i>
                    <span>Pedir ajuda</span>
                </a>
            </div>
        </article>

    </div>
</section>

<section class="why-help">
    <h2 class="section-title">Por que nos ajudar?</h2>

    <div class="why-help-content">
        <article class="why-help-card">
            <div class="why-help-icon">
                <i class="fa-solid fa-heart-circle-check"></i>
            </div>
            <h3>Impacto direto</h3>
            <p>Cada doação vira ração, vacina, exame e castração para um gato que estava na rua.</p>
        </article>

        <article class="why-help-card">
            <div class="why-help-icon">
                <i class="fa-solid fa-file-invoice-dollar"></i>
            </div>
            <h3>Transparência total</h3>
            <p>Prestamos contas de cada gasto do projeto na nossa página de <a href="#">Transparência</a>.</p>
        </article>

        <article class="why-help-card">
            <div class="why-help-icon">
                <i class="fa-solid fa-hand-holding-heart"></i>
            </div>
            <h3>Trabalho 100% voluntário</h3>
            <p>Não recebemos salário nem temos fins lucrativos — tudo é feito por amor aos gatos.</p>
        </article>
    </div>
</section>