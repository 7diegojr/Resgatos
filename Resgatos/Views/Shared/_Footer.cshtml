<footer>
    <div class="footer-content">

        <div class="footer-brand">
            <a class="footer-logo" asp-area="" asp-controller="Home" asp-action="Index">
                <img src="~/img/layout/logo.png" alt="Resgatos">
            </a>
            <button class="footer-donate-btn" type="button">
                <i class="fa-solid fa-heart"></i>
                <span>Doe aqui e mude uma vidinha!</span>
            </button>
        </div>

        <div class="footer-social">
            <h3 class="footer-heading">Nos siga nas Redes Sociais!</h3>
            <a class="footer-contact-item" href="#" target="_blank">
                <i class="fa-brands fa-instagram"></i>
                <span>Instagram</span>
            </a>
            <a class="footer-contact-item" href="#" target="_blank">
                <i class="fa-brands fa-facebook-f"></i>
                <span>Facebook</span>
            </a>
            <a class="footer-contact-item" href="#" target="_blank">
                <i class="fa-brands fa-tiktok"></i>
                <span>TikTok</span>
            </a>
        </div>

        <div class="footer-menu">
            <h3 class="footer-heading">Menu</h3>
            <div class="footer-menu-columns">
                <ul class="footer-menu-list">
                    <li><a asp-area="" asp-controller="Home" asp-action="Index">Início</a></li>
                    <li><a asp-area="" asp-controller="Adocoes" asp-action="Index">Adoções</a></li>
                    <li><a asp-area="" asp-controller="Doacoes" asp-action="Index">Doações</a></li>
                </ul>
                <ul class="footer-menu-list">
                    <li><a asp-area="" asp-controller="SobreNos" asp-action="Index">Sobre nós</a></li>
                    <li><a asp-area="" asp-controller="Transparencia" asp-action="Index">Transparência</a></li>
                </ul>
            </div>
        </div>

        <div class="footer-contact">
            <h3 class="footer-heading">Contatos</h3>
            <span class="footer-contact-item">
                <i class="fa-solid fa-location-dot"></i>
                Curitiba - PR
            </span>
            <a class="footer-contact-item" href="mailto:contato@resgatos.com.br" target="_blank">
                <i class="fa-solid fa-envelope"></i>
                <span>contato@resgatos.com.br</span>
            </a>
            <a class="footer-contact-item" href="https://wa.me/554184723090" target="_blank">
                <i class="fa-brands fa-whatsapp"></i>
                <span>(41) 8472-3090</span>
            </a>
        </div>

    </div>

    <div class="footer-divider"></div>

    <div class="footer-copyright">
        &copy; @DateTime.Now.Year ResGatos. Todos os direitos reservados.
    </div>
</footer>