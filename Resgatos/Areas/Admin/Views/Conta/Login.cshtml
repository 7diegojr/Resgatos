@model LoginViewModel
@{
    ViewData["Title"] = "Entrar";
    Layout = "_LoginLayout";
}

<section class="login-card">
    <h1 class="login-title">Área administrativa</h1>
    <p class="login-subtitle">Entre com o e-mail e a senha cadastrados.</p>

    <form asp-area="Admin" asp-controller="Conta" asp-action="Login" method="post" class="login-form" novalidate>
        <input type="hidden" asp-for="ReturnUrl" />

        <div asp-validation-summary="ModelOnly" class="login-alert" role="alert"></div>

        <div class="login-field">
            <label asp-for="Email"></label>
            <input asp-for="Email" type="email" placeholder="seuemail@exemplo.com" autocomplete="username" autofocus />
            <span asp-validation-for="Email" class="login-error"></span>
        </div>

        <div class="login-field">
            <label asp-for="Senha"></label>
            <div class="login-password">
                <input asp-for="Senha" placeholder="Digite sua senha" autocomplete="current-password" />
                <button type="button" class="login-password-toggle" id="login-toggle-senha"
                        aria-label="Mostrar senha" aria-pressed="false">
                    <i class="fa-solid fa-eye" aria-hidden="true"></i>
                </button>
            </div>
            <span asp-validation-for="Senha" class="login-error"></span>
        </div>

        <button type="submit" class="btn-pill btn-pill-blue login-submit">Entrar</button>
    </form>
</section>
