<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <partial name="_AdminHead" />
    <title>@ViewData["Title"] - Admin Resgatos</title>
</head>

<body class="admin-body">

    <header class="admin-header">
        <a class="admin-logo" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
            <img src="~/img/layout/logo.png" alt="Resgatos">
            <span class="admin-logo-tag">Admin</span>
        </a>

        <div class="admin-user">
            <span class="admin-user-name"><i class="fa-solid fa-circle-user" aria-hidden="true"></i> @User.Identity.Name</span>

            <form asp-area="Admin" asp-controller="Conta" asp-action="Logout" method="post">
                <button type="submit" class="admin-logout">
                    <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i> Sair
                </button>
            </form>
        </div>
    </header>

    <main class="admin-main" role="main">
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
