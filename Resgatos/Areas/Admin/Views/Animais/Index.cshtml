@model AnimaisIndexViewModel
@using Resgatos.Helpers
@{
    ViewData["Title"] = "Animais";

    var filtro = Model.Filtro;

    // Parâmetros da URL com todos os filtros atuais, trocando só o que muda (status da aba ou página)
    Dictionary<string, string> Rota(StatusAnimal? status, int pagina = 1)
    {
        var d = filtro.ParaRota("status");
        if (status.HasValue) d["status"] = status.Value.ToString();
        if (pagina > 1) d["pagina"] = pagina.ToString();
        return d;
    }

    string TextoOrdem(OrdenacaoAnimaisAdmin ordem) => ordem switch
    {
        OrdenacaoAnimaisAdmin.MaisTempo => "Mais tempo",
        OrdenacaoAnimaisAdmin.NomeAZ => "Nome (A–Z)",
        OrdenacaoAnimaisAdmin.NomeZA => "Nome (Z–A)",
        _ => "Menos tempo"
    };

    // Resumo dos filtros que só existem no modal (aparece ao passar o mouse no botão "Filtrar")
    var resumoAvancados = new List<string>();
    if (filtro.Sexo.HasValue) resumoAvancados.Add($"Sexo: {filtro.Sexo.Value.GetDisplayName()}");
    if (filtro.Porte.HasValue) resumoAvancados.Add($"Porte: {filtro.Porte.Value.GetDisplayName()}");
    if (filtro.FaixaEtaria.HasValue) resumoAvancados.Add($"Faixa etária: {filtro.FaixaEtaria.Value.GetDisplayName()}");
    if (filtro.Saude.HasValue) resumoAvancados.Add("Saúde: " + (filtro.Saude == FiltroSaudeAdmin.Completa ? "Completa" : "Com pendências"));

    // Link do "Limpar filtros": tira todos os filtros e mantém só a busca
    var rotaLimpar = filtro.ParaRota("status", "especie", "sexo", "porte", "faixaEtaria", "saude", "ordem");

    // Caixa de seleção de um filtro do modal (a opção vazia é "Todos"/"Todas")
    CampoSelectViewModel CampoFiltro<T>(string nome, string rotulo, string todos, T? atual, Func<T, string> texto = null, Func<T, bool> incluir = null) where T : struct, Enum => new()
    {
        Nome = nome,
        Rotulo = rotulo,
        Obrigatorio = false,
        Placeholder = todos,
        OpcaoVaziaEhResposta = true,
        Opcoes = Enum.GetValues<T>()
            .Where(v => incluir == null || incluir(v))
            .Select(v => new OpcaoSelectViewModel(v.ToString(), texto != null ? texto(v) : ((Enum)v).GetDisplayName(), atual.HasValue && EqualityComparer<T>.Default.Equals(atual.Value, v)))
            .ToList()
    };

    // "Adotado" não existe nesta lista: animal adotado fica só na página Adotados
    var campoStatus = CampoFiltro("status", "Status", "Todos", filtro.Status, incluir: st => st != StatusAnimal.Adotado);
    var campoEspecie = CampoFiltro("especie", "Espécie", "Todas", filtro.Especie, e => e == EspecieAnimal.Gato ? "Gatos" : "Cachorros");
    var campoSexo = CampoFiltro("sexo", "Sexo", "Todos", filtro.Sexo);
    var campoPorte = CampoFiltro("porte", "Porte", "Todos", filtro.Porte);
    var campoFaixa = CampoFiltro("faixaEtaria", "Faixa etária", "Todas", filtro.FaixaEtaria);
    var campoSaude = CampoFiltro("saude", "Saúde", "Todas", filtro.Saude, v => v == FiltroSaudeAdmin.Completa ? "Completa" : "Com pendências");
    var campoOrdem = CampoFiltro<OrdenacaoAnimaisAdmin>("ordem", "Ordenar por", null, filtro.Ordem, TextoOrdem);
    campoOrdem.PermiteVazio = false;

    // Filtros rápidos da barra: status, espécie e ordenação (os mesmos do modal, sempre com o mesmo valor)
    var rapidoStatus = CampoFiltro("status", "Status", "Todos", filtro.Status, incluir: st => st != StatusAnimal.Adotado);
    rapidoStatus.Id = "rapido-status";
    var rapidoEspecie = CampoFiltro("especie", "Espécie", "Todas", filtro.Especie, e => e == EspecieAnimal.Gato ? "Gatos" : "Cachorros");
    rapidoEspecie.Id = "rapido-especie";
    var rapidoOrdem = CampoFiltro<OrdenacaoAnimaisAdmin>("ordem", "Ordenar por", null, filtro.Ordem, TextoOrdem);
    rapidoOrdem.Id = "rapido-ordem";
    rapidoOrdem.PermiteVazio = false;

    // Páginas a mostrar na paginação (0 = "…")
    var paginas = new List<int>();
    for (var p = 1; p <= Model.TotalPaginas; p++)
    {
        if (p == 1 || p == Model.TotalPaginas || Math.Abs(p - Model.Pagina) <= 1)
            paginas.Add(p);
        else if (paginas.Count > 0 && paginas[^1] != 0)
            paginas.Add(0);
    }

    var semAnimais = Model.TotalGeral == 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/animais.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/adotar-modal.css" asp-append-version="true" />
}

<header class="admin-page-header">
    <div class="admin-page-header-text">
        <h1 class="admin-page-title">Animais</h1>
        <p class="admin-page-subtitle">
            @if (semAnimais)
            {
                <text>Cadastre os animais resgatados para que eles apareçam no site quando estiverem disponíveis.</text>
            }
            else
            {
                <text>@Model.TotalGeral @(Model.TotalGeral == 1 ? "animal cadastrado" : "animais cadastrados"). Só os <strong>disponíveis</strong> aparecem no site.</text>
            }
        </p>
    </div>

    <a class="admin-btn admin-btn-primary" asp-area="Admin" asp-controller="Animais" asp-action="Criar">
        <i class="fa-solid fa-plus" aria-hidden="true"></i><span>Novo animal</span>
    </a>
</header>

@if (semAnimais)
{
    <section class="admin-empty" aria-label="Nenhum animal cadastrado">
        <span class="admin-empty-icon" aria-hidden="true"><i class="fa-solid fa-paw"></i></span>
        <h2 class="admin-empty-title">Nenhum animal cadastrado ainda</h2>
        <p class="admin-empty-text">Quando você cadastrar o primeiro, ele aparece aqui.</p>
        <a class="admin-btn admin-btn-primary" asp-area="Admin" asp-controller="Animais" asp-action="Criar">
            <i class="fa-solid fa-plus" aria-hidden="true"></i><span>Cadastrar o primeiro animal</span>
        </a>
    </section>
}
else
{
    @* ============ Abas de status ============ *@
    <nav class="status-tabs" aria-label="Filtrar por status">
        <a class="status-tab@(filtro.Status == null ? " is-active" : "")"
           aria-current="@(filtro.Status == null ? "true" : null)"
           asp-area="Admin" asp-controller="Animais" asp-action="Index" asp-all-route-data="Rota(null)">
            Todos <span class="status-tab-count">@Model.TotalGeral</span>
        </a>

        @foreach (var status in Enum.GetValues<StatusAnimal>().Where(st => st != StatusAnimal.Adotado))
        {
            var quantidade = Model.ContagemPorStatus.GetValueOrDefault(status);
            var ativa = filtro.Status == status;
            <a class="status-tab@(ativa ? " is-active" : "")"
               aria-current="@(ativa ? "true" : null)"
               asp-area="Admin" asp-controller="Animais" asp-action="Index" asp-all-route-data="Rota(status)">
                @status.GetDisplayName() <span class="status-tab-count">@quantidade</span>
            </a>
        }
    </nav>

    @* ============ Busca e botão Filtrar (abre o modal) ============ *@
    <form class="animais-toolbar" method="get" asp-area="Admin" asp-controller="Animais" asp-action="Index" role="search" id="animais-busca">
        @* Os filtros que só existem no modal (sexo, porte...) vão escondidos: buscar ou trocar um filtro rápido não os perde *@
        @foreach (var parametro in filtro.ParaRota("busca", "status", "especie", "ordem"))
        {
            <input type="hidden" name="@parametro.Key" value="@parametro.Value" />
        }

        <div class="toolbar-search">
            <button type="submit" class="toolbar-search-btn" aria-label="Buscar">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            </button>
            <input type="search" name="busca" value="@filtro.Busca" placeholder="Buscar pelo nome"
                   aria-label="Buscar pelo nome do animal" autocomplete="off" />
        </div>

        @* Filtros rápidos: trocar qualquer um já filtra. São os mesmos campos do modal, então os dois sempre mostram o mesmo valor *@
        <div class="toolbar-rapido">
            <partial name="_CampoSelect" model="rapidoStatus" />
        </div>
        <div class="toolbar-rapido">
            <partial name="_CampoSelect" model="rapidoEspecie" />
        </div>
        <div class="toolbar-rapido">
            <partial name="_CampoSelect" model="rapidoOrdem" />
        </div>

        @* "Limpar filtros" fica na linha dos títulos dos filtros rápidos, em cima do botão Filtrar.
           O espaço é sempre reservado (com ou sem o link), para a página nunca mudar de lugar quando ele aparece. *@
        <div class="toolbar-filtrar-grupo">
            <div class="toolbar-limpar">
                @if (filtro.QuantidadeFiltrosAtivos > 0)
                {
                    <a class="toolbar-clear" asp-area="Admin" asp-controller="Animais" asp-action="Index" asp-all-route-data="rotaLimpar">Limpar filtros</a>
                }
                else
                {
                    <span aria-hidden="true">&nbsp;</span>
                }
            </div>

            <button type="button" class="admin-btn admin-btn-outline toolbar-filtrar" data-abrir-filtros aria-haspopup="dialog"
                    title="@(resumoAvancados.Count > 0 ? string.Join(" · ", resumoAvancados) : "Mais filtros")">
                <i class="fa-solid fa-filter" aria-hidden="true"></i>
                <span>Filtrar</span>
                @if (filtro.QuantidadeFiltrosAvancados > 0)
                {
                    <span class="toolbar-filtrar-badge" aria-label="@filtro.QuantidadeFiltrosAvancados @(filtro.QuantidadeFiltrosAvancados == 1 ? "filtro aplicado no modal" : "filtros aplicados no modal")">@filtro.QuantidadeFiltrosAvancados</span>
                }
            </button>
        </div>
    </form>

    @if (Model.Animais.Count == 0)
    {
        <section class="admin-empty" aria-label="Nenhum animal encontrado">
            <span class="admin-empty-icon" aria-hidden="true"><i class="fa-solid fa-magnifying-glass"></i></span>
            <h2 class="admin-empty-title">Nenhum animal encontrado</h2>
            <p class="admin-empty-text">Nenhum animal bate com a busca e os filtros aplicados. Tente outra busca ou ajuste os filtros.</p>
            <a class="admin-btn admin-btn-outline" asp-area="Admin" asp-controller="Animais" asp-action="Index">
                <span>Ver todos os animais</span>
            </a>
        </section>
    }
    else
    {
        @* ============ Tabela ============ *@
        <div class="admin-card animais-card">
            <table class="animais-table tabela-animais">
                <caption class="visually-hidden">Lista de animais cadastrados</caption>
                <thead>
                    <tr>
                        <th scope="col">Animal</th>
                        <th scope="col">Espécie e sexo</th>
                        <th scope="col">Idade</th>
                        <th scope="col">Status</th>
                        <th scope="col">Saúde</th>
                        <th scope="col">No Resgatos</th>
                        <th scope="col" class="col-acoes">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var animal in Model.Animais)
                    {
                        var pendencias = animal.Pendencias;
                        var ehGato = animal.Especie == EspecieAnimal.Gato;

                        <tr>
                            <td class="cell-animal">
                                <a class="animal-ident" asp-area="Admin" asp-controller="Animais" asp-action="Detalhes" asp-route-id="@animal.IdAnimal">
                                    <span class="animal-thumb">
                                        @if (!string.IsNullOrEmpty(animal.FotoCapa))
                                        {
                                            <img src="@Url.Content("~/" + animal.FotoCapa)" alt="Foto de @animal.Nome" loading="lazy">
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-paw" aria-hidden="true"></i>
                                        }
                                    </span>
                                    <span class="animal-ident-text">
                                        <strong class="animal-name">@animal.Nome</strong>
                                        <span class="animal-meta">
                                            @animal.Cor
                                            <span aria-hidden="true">·</span>
                                            <i class="fa-regular fa-image" aria-hidden="true"></i>
                                            @animal.QtdFotos <span class="visually-hidden">@(animal.QtdFotos == 1 ? "foto" : "fotos")</span>
                                        </span>
                                    </span>
                                </a>
                            </td>

                            <td data-label="Espécie e sexo">
                                <span class="cell-species">
                                    <i class="fa-solid @(ehGato ? "fa-cat" : "fa-dog")" aria-hidden="true"></i>
                                    @animal.Especie.GetDisplayName()
                                </span>
                                <span class="cell-sub">@animal.Sexo.GetDisplayName()</span>
                            </td>

                            <td data-label="Idade">
                                <span class="cell-main">@animal.IdadeEstimada</span>
                                <span class="cell-sub">@animal.FaixaEtaria.GetDisplayName()</span>
                            </td>

                            <td data-label="Status">
                                <span class="status-badge status-@animal.Status.ToString().ToLower()">@animal.Status.GetDisplayName()</span>
                            </td>

                            <td data-label="Saúde">
                                @if (pendencias.Count == 0)
                                {
                                    <span class="health-pill health-ok"><i class="fa-solid fa-circle-check" aria-hidden="true"></i> Completa</span>
                                }
                                else
                                {
                                    <span class="health-pill health-pending" title="Falta: @(string.Join(", ", pendencias))">
                                        <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                                        @pendencias.Count @(pendencias.Count == 1 ? "pendência" : "pendências")
                                    </span>
                                    <span class="cell-sub">@(string.Join(", ", pendencias.Take(2)))@(pendencias.Count > 2 ? " +" + (pendencias.Count - 2) : "")</span>
                                }
                            </td>

                            <td data-label="No Resgatos">
                                @if (animal.DataChegada.HasValue)
                                {
                                    @* O tempo é calculado na hora (ToTempoDecorrido): se atualiza sozinho conforme os meses passam *@
                                    <span class="cell-main">@animal.TempoNoResgatos</span>
                                    <span class="cell-sub">Desde @animal.DataChegada.Value.ToString("MM/yyyy")</span>
                                }
                                else
                                {
                                    <span class="cell-main cell-vazio">—</span>
                                    <span class="cell-sub">Não informada</span>
                                }
                            </td>

                            <td class="cell-acoes">
                                <div class="row-actions">
                                    @* Adoção (Sprint 14): abre o modal "Marcar como adotado". Depois de adotado, o animal sai desta lista e fica só em Adotados. *@
                                    <button type="button" class="row-action row-action-adotar" data-adotar
                                            data-id="@animal.IdAnimal"
                                            data-nome="@animal.Nome"
                                            data-foto="@(string.IsNullOrEmpty(animal.FotoCapa) ? "" : Url.Content("~/" + animal.FotoCapa))"
                                            data-especie="@animal.Especie.GetDisplayName()"
                                            data-sexo="@animal.Sexo.GetDisplayName()"
                                            data-idade="@animal.IdadeEstimada"
                                            data-faixa="@animal.FaixaEtaria.GetDisplayName()"
                                            data-porte="@animal.Porte.GetDisplayName()"
                                            data-cor="@animal.Cor"
                                            data-tempo="@animal.TempoNoResgatos"
                                            data-castrado="@(animal.CastradoOk ? "Sim" : "Não")"
                                            data-pendencias="@(string.Join(", ", pendencias))"
                                            title="Marcar como adotado" aria-label="Marcar @animal.Nome como adotad@(animal.Sexo.ArtigoDefinido())">
                                        <i class="fa-solid fa-heart" aria-hidden="true"></i>
                                    </button>
                                    <a class="row-action" asp-area="Admin" asp-controller="Animais" asp-action="Detalhes" asp-route-id="@animal.IdAnimal"
                                       title="Ver detalhes" aria-label="Ver detalhes de @animal.Nome">
                                        <i class="fa-solid fa-eye" aria-hidden="true"></i>
                                    </a>
                                    <a class="row-action" asp-area="Admin" asp-controller="Animais" asp-action="Editar" asp-route-id="@animal.IdAnimal"
                                       title="Editar" aria-label="Editar @animal.Nome">
                                        <i class="fa-solid fa-pen" aria-hidden="true"></i>
                                    </a>
                                    @* Abre o modal de confirmação (data-confirmar); o POST só acontece se a pessoa confirmar *@
                                    <button type="button" class="row-action row-action-danger" data-confirmar
                                            data-url="@Url.Action("Excluir", "Animais", new { area = "Admin", id = animal.IdAnimal })"
                                            data-titulo="@animal.Sexo.PerguntaExcluir(animal.Nome)"
                                            data-texto="@animal.Sexo.AvisoExcluir(animal.Nome)"
                                            data-botao="Excluir"
                                            title="Excluir" aria-label="Excluir @animal.Nome">
                                        <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @* ============ Rodapé: contagem + paginação ============ *@
            <div class="animais-footer">
                <p class="animais-count">
                    Mostrando <strong>@Model.PrimeiroItem–@Model.UltimoItem</strong> de <strong>@Model.TotalFiltrado</strong>
                    @(Model.TotalFiltrado == 1 ? "animal" : "animais")
                </p>

                @if (Model.TotalPaginas > 1)
                {
                    <nav class="pagination" aria-label="Paginação">
                        @if (Model.Pagina > 1)
                        {
                            <a class="page-link" asp-area="Admin" asp-controller="Animais" asp-action="Index"
                               asp-all-route-data="Rota(filtro.Status, Model.Pagina - 1)" aria-label="Página anterior">
                                <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
                            </a>
                        }

                        @foreach (var p in paginas)
                        {
                            if (p == 0)
                            {
                                <span class="page-gap" aria-hidden="true">…</span>
                            }
                            else if (p == Model.Pagina)
                            {
                                <span class="page-link is-current" aria-current="page">@p</span>
                            }
                            else
                            {
                                <a class="page-link" asp-area="Admin" asp-controller="Animais" asp-action="Index"
                                   asp-all-route-data="Rota(filtro.Status, p)" aria-label="Página @p">@p</a>
                            }
                        }

                        @if (Model.Pagina < Model.TotalPaginas)
                        {
                            <a class="page-link" asp-area="Admin" asp-controller="Animais" asp-action="Index"
                               asp-all-route-data="Rota(filtro.Status, Model.Pagina + 1)" aria-label="Próxima página">
                                <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                            </a>
                        }
                    </nav>
                }
            </div>
        </div>
    }
}

@if (!semAnimais)
{
    @* ============ Modal "Marcar como adotado" (Sprint 14) ============ *@
    <partial name="_ModalAdotar" />

    @* ============ Modal de filtros: abre pelo botão "Filtrar" ============ *@
    <dialog class="admin-modal filtros-modal" id="modal-filtros" aria-labelledby="titulo-filtros">
        @* Mesmo botão de fechar do modal de animais do site (fora do formulário, para ficar parado quando o modal rola) *@
        <button type="button" class="filtros-fechar" data-fechar-filtros aria-label="Fechar filtros">
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>

        <form method="get" class="filtros-form" id="form-filtros" asp-area="Admin" asp-controller="Animais" asp-action="Index">
            @* A busca continua valendo quando os filtros são aplicados *@
            @if (!string.IsNullOrWhiteSpace(filtro.Busca))
            {
                <input type="hidden" name="busca" value="@filtro.Busca" />
            }

            <header class="filtros-topo">
                <div>
                    <h2 class="filtros-titulo" id="titulo-filtros">Filtrar animais</h2>
                    <p class="filtros-sub">Escolha o que você quer ver na lista.</p>
                </div>
            </header>

            <div class="filtros-grid">
                <partial name="_CampoSelect" model="campoStatus" />
                <partial name="_CampoSelect" model="campoEspecie" />
                <partial name="_CampoSelect" model="campoSexo" />
                <partial name="_CampoSelect" model="campoPorte" />
                <partial name="_CampoSelect" model="campoFaixa" />
                <partial name="_CampoSelect" model="campoSaude" />

                <div class="filtros-campo-largo">
                    <partial name="_CampoSelect" model="campoOrdem" />
                </div>
            </div>

            <div class="filtros-acoes">
                <button type="submit" class="admin-btn admin-btn-primary">
                    <i class="fa-solid fa-check" aria-hidden="true"></i><span>Aplicar filtros</span>
                </button>
                <a class="admin-btn admin-btn-outline" asp-area="Admin" asp-controller="Animais" asp-action="Index" asp-all-route-data="rotaLimpar">Limpar filtros</a>
            </div>
        </form>
    </dialog>
}

@section Scripts {
    <script src="~/js/admin/animais.js" asp-append-version="true"></script>
    <script src="~/js/admin/adotar-animal.js" asp-append-version="true"></script>
}
