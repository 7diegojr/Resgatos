@*
    Modal grande "Marcar como adotado" (Sprint 14). Fica na lista de Animais e é aberto pelo botão com data-adotar.
    Em cima: o animal (foto e nome à esquerda, informações ao lado). Embaixo: quem está adotando e a adoção.
    O adotar-animal.js preenche o animal com os data-* do botão e envia o formulário por fetch
    para Adotados/Registrar (os erros aparecem nos campos, sem perder o que foi preenchido).
*@
@{
    var hoje = DateTime.Today.ToString("yyyy-MM-dd");
}

<dialog class="admin-modal adotar-modal" id="modal-adotar" aria-labelledby="adotar-titulo">
    <button type="button" class="filtros-fechar" data-fechar-adotar aria-label="Fechar">
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
    </button>

    <form method="post" id="form-adotar" class="adotar-form" enctype="multipart/form-data" novalidate
          asp-area="Admin" asp-controller="Adotados" asp-action="Registrar">
        <input type="hidden" name="IdAnimal" id="adotar-id" />

        <header class="adotar-topo">
            <h2 class="filtros-titulo" id="adotar-titulo">Marcar como adotado</h2>
            <p class="filtros-sub">Confira o animal e preencha os dados de quem está adotando. Os campos com <span class="form-required">*</span> são obrigatórios.</p>
        </header>

        @* ===================== Animal ===================== *@
        <section class="adotar-animal" aria-label="Animal">
            <div class="adotar-foto">
                <img id="adotar-foto-img" alt="" hidden />
                <span class="adotar-foto-vazia" id="adotar-foto-vazia" aria-hidden="true"><i class="fa-solid fa-paw"></i></span>
            </div>

            <div class="adotar-animal-info">
                <h3 class="adotar-animal-nome" id="adotar-animal-nome"></h3>

                <ul class="adotar-fatos">
                    <li><small>Espécie</small><strong id="adotar-especie"></strong></li>
                    <li><small>Sexo</small><strong id="adotar-sexo"></strong></li>
                    <li class="fato-idade"><small>Idade</small><strong id="adotar-idade"></strong></li>
                    <li><small>Porte</small><strong id="adotar-porte"></strong></li>
                    <li><small>Cor</small><strong id="adotar-cor"></strong></li>
                    <li><small>No Resgatos</small><strong id="adotar-tempo"></strong></li>
                    <li><small>Castrado</small><strong id="adotar-castrado"></strong></li>
                    <li id="adotar-saude-item"><small>Saúde</small><strong id="adotar-saude"></strong></li>
                </ul>
            </div>
        </section>

        <p class="form-alert" id="adotar-alerta" role="alert" hidden>
            <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
            <span></span>
        </p>

        @* ===================== Quem está adotando ===================== *@
        <section class="adotar-bloco" aria-labelledby="adotar-t-adotante">
            <h3 class="adotar-bloco-titulo" id="adotar-t-adotante">Quem está adotando</h3>
            <div class="adotar-campos">
                <div class="form-field">
                    <label for="NomeAdotante">Nome completo<span class="form-required" aria-hidden="true">*</span></label>
                    <input type="text" id="NomeAdotante" name="NomeAdotante" maxlength="150" autocomplete="off"
                           placeholder="Ex.: Maria da Silva" data-required data-msg="Informe o nome de quem está adotando." />
                    <span class="field-error" role="alert"></span>
                </div>

                @* Telefone com largura fixa; o e-mail ocupa todo o resto da linha *@
                <div class="adotar-linha adotar-linha-contato">
                    <div class="form-field">
                        <label for="Telefone">Telefone / WhatsApp<span class="form-required" aria-hidden="true">*</span></label>
                        <input type="text" id="Telefone" name="Telefone" maxlength="15" inputmode="tel" autocomplete="off"
                               placeholder="(41) 99999-9999" data-required data-msg="Informe o telefone." />
                        <span class="field-error" role="alert"></span>
                    </div>

                    <div class="form-field">
                        <label for="Email">E-mail<span class="form-required" aria-hidden="true">*</span></label>
                        <input type="text" id="Email" name="Email" maxlength="150" inputmode="email" autocomplete="off"
                               placeholder="nome@email.com" data-required data-msg="Informe o e-mail." />
                        <span class="field-error" role="alert"></span>
                    </div>
                </div>

                <div class="form-field">
                    <label for="Endereco">Endereço completo<span class="form-required" aria-hidden="true">*</span></label>
                    <input type="text" id="Endereco" name="Endereco" maxlength="255" autocomplete="off"
                           placeholder="Rua, número, bairro, Curitiba" data-required data-msg="Informe o endereço completo." />
                    <span class="field-error" role="alert"></span>
                </div>
            </div>
        </section>

        @* ===================== A adoção ===================== *@
        <section class="adotar-bloco" aria-labelledby="adotar-t-adocao">
            <h3 class="adotar-bloco-titulo" id="adotar-t-adocao">A adoção</h3>
            <div class="adotar-campos">
                @* Data e valor: uma linha, metade da largura para cada *@
                <div class="adotar-linha">
                    <div class="form-field">
                        <label for="DataAdocao">Data da adoção<span class="form-required" aria-hidden="true">*</span></label>
                        <input type="date" id="DataAdocao" name="DataAdocao" max="@hoje" data-required data-msg="Informe a data da adoção." />
                        <span class="field-error" role="alert"></span>
                    </div>

                    <div class="form-field">
                        <label for="Valor">Valor da taxa<span class="form-required" aria-hidden="true">*</span></label>
                        <div class="campo-valor">
                            <span class="campo-valor-prefixo" aria-hidden="true">R$</span>
                            <input type="text" id="Valor" name="Valor" inputmode="decimal" maxlength="14" autocomplete="off"
                                   placeholder="0,00" data-required data-msg="Informe o valor da taxa." />
                        </div>
                        <span class="field-error" role="alert"></span>
                    </div>
                </div>

                @* Parcelada? e quantidade de parcelas: uma linha, metade da largura para cada *@
                <div class="adotar-linha">
                    <div class="form-field">
                        <label class="check-card adotar-parcelada">
                            <input type="checkbox" id="TaxaParcelada" name="TaxaParcelada" value="true" />
                            <span class="check-box" aria-hidden="true"></span>
                            <span>A taxa foi parcelada?</span>
                        </label>
                    </div>

                    @* Sempre ocupa o lugar (só fica invisível) para o modal não mudar de tamanho ao marcar a caixa *@
                    <div class="form-field adotar-parcelas" id="campo-parcelas" data-oculto>
                        <label for="QtdParcelas">Em quantas parcelas?<span class="form-required" aria-hidden="true">*</span></label>
                        <input type="text" id="QtdParcelas" name="QtdParcelas" inputmode="numeric" maxlength="2" autocomplete="off"
                               placeholder="Ex.: 3" disabled />
                        <span class="field-error" role="alert"></span>
                    </div>
                </div>

                <div class="form-field">
                    <label for="Observacoes">Observações <span class="form-opcional">(opcional)</span></label>
                    <textarea id="Observacoes" name="Observacoes" class="textarea-curta" maxlength="500" rows="3"
                              placeholder="Conte o que ajudar: outros animais em casa, tipo de moradia, cuidados combinados..."></textarea>
                    <span class="field-error" role="alert"></span>
                </div>

                <div class="form-field" id="campo-termo">
                    <label for="Termo">Termo de adoção assinado <span class="form-opcional">(opcional)</span></label>
                    <p class="form-hint">Foto ou PDF, até 5 MB.</p>

                    <input type="file" id="Termo" name="Termo" class="visually-hidden" accept="image/jpeg,image/png,image/webp,application/pdf" />

                    <label for="Termo" class="adotar-arquivo-zona" id="termo-zona">
                        <span class="adotar-arquivo-icone" aria-hidden="true"><i class="fa-solid fa-file-arrow-up"></i></span>
                        <span class="adotar-arquivo-textos">
                            <strong>Clique para escolher o termo</strong>
                            <small>ou arraste e solte aqui</small>
                        </span>
                    </label>

                    <div class="adotar-arquivo-escolhido" id="termo-escolhido" hidden>
                        <span class="adotar-arquivo-icone" aria-hidden="true"><i class="fa-solid fa-file-circle-check"></i></span>
                        <span class="adotar-arquivo-textos">
                            <strong id="termo-nome"></strong>
                            <small id="termo-tamanho"></small>
                        </span>
                        <button type="button" class="adotar-arquivo-remover" id="termo-remover" aria-label="Remover o termo escolhido">
                            <i class="fa-solid fa-trash-can" aria-hidden="true"></i> Remover
                        </button>
                    </div>

                    <span class="field-error" role="alert"></span>
                </div>
            </div>
        </section>

        <div class="form-actions adotar-acoes">
            <button type="submit" class="admin-btn admin-btn-primary" id="adotar-salvar">
                <i class="fa-solid fa-heart" aria-hidden="true"></i><span>Confirmar adoção</span>
            </button>
            <button type="button" class="admin-btn admin-btn-outline" data-fechar-adotar>Cancelar</button>
        </div>
    </form>
</dialog>
